datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  orders          Order[]
  paymentAttempts PaymentAttempt[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String   @id
  name          String
  price         Decimal  @db.Decimal(10, 2)
  image         String
  category      String
  description   String   @db.Text
  descriptionEn String   @db.Text
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique // e.g., LUM-1234-AR
  createdAt        DateTime        @default(now())
  status           String          @default("Procesando")
  total            Float
  currency         String          @default("USD")
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  items            Json // Array of products purchased
  address          String
  recipientName    String          @default("No especificado")
  phone            String          @default("No especificado")
  city             String          @default("No especificado")
  zipCode          String          @default("No especificado")
  additionalInfo   String?
  deliveryDate     DateTime
  warrantyUntil    DateTime
  paymentAttemptId String?         @unique
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
}

model PaymentAttempt {
  id                String   @id @default(cuid())
  reference         String   @unique
  provider          String
  providerPaymentId String?  @unique
  status            String   @default("PENDING")
  currency          String
  subtotalUsd       Decimal  @db.Decimal(12, 2)
  totalUsd          Decimal  @db.Decimal(12, 2)
  totalArs          Decimal? @db.Decimal(14, 2)
  exchangeRate      Decimal? @db.Decimal(12, 4)
  quoteId           String?  @db.Text
  items             Json
  recipientName     String
  phone             String
  address           String
  city              String
  zipCode           String
  additionalInfo    String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order             Order?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([provider, status])
}
